{
	"Dinic": {
		"prefix": ["dinic", "Dinic", "maxflow", "mincut"],
		"body": [
			"struct Edge {",
			"\tll to, rev;",
			"\tll cap;",
			"\tEdge(ll to, ll rev, ll cap) : to(to), rev(rev), cap(cap) {}",
			"};",
			"",
			"struct Dinic {",
			"\tll n;",
			"\tvector<vector<Edge>> adj;",
			"\tvl level, ptr;",
			"",
			"\tDinic(ll n) : n(n) {",
			"\t\tadj.assign(n, vector<Edge>());",
			"\t\tlevel.assign(n, -1);",
			"\t\tptr.assign(n, 0);",
			"\t}",
			"",
			"\tvoid add_edge(ll u, ll v, ll cap) {",
			"\t\tadj[u].emplace_back(v, (ll)adj[v].size(), cap);",
			"\t\tadj[v].emplace_back(u, (ll)adj[u].size() - 1, 0); // reverse edge",
			"\t}",
			"",
			"\tvoid print_all_edges() {",
			"\t\tfor (ll u = 0; u < n; u++) {",
			"\t\t\tfor (ll i = 0; i < (ll)adj[u].size(); i++) {",
			"\t\t\t\tEdge &e = adj[u][i];",
			"",
			"\t\t\t\tbool is_backward = false;",
			"\t\t\t\tis_backward = (adj[e.to][e.rev].to == u) && (i % 2 == 1);",
			"",
			"\t\t\t\tcout << \"Edge from \" << u << \" to \" << e.to ",
			"\t\t\t\t\t<< \" | cap = \" << e.cap",
			"\t\t\t\t\t<< \" | \" << (is_backward ? \"Backward edge\" : \"Forward edge\") << \"\\n\";",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"",
			"\tbool bfs(ll s, ll t) {",
			"\t\tfill(level.begin(), level.end(), -1);",
			"\t\tlevel[s] = 0;",
			"\t\tqueue<ll> q; q.push(s);",
			"\t\twhile (!q.empty()) {",
			"\t\t\tll u = q.front(); q.pop();",
			"\t\t\tfor (auto &e : adj[u]) {",
			"\t\t\t\tif (e.cap > 0 && level[e.to] == -1) {",
			"\t\t\t\t\tlevel[e.to] = level[u] + 1;",
			"\t\t\t\t\tq.push(e.to);",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn level[t] != -1;",
			"\t}",
			"",
			"\tll dfs(ll u, ll t, ll flow) {",
			"\t\tif (u == t || flow == 0) return flow;",
			"\t\tfor (ll &i = ptr[u]; i < (ll)adj[u].size(); i++) {",
			"\t\t\tEdge &e = adj[u][i];",
			"\t\t\tif (level[e.to] == level[u] + 1 && e.cap > 0) {",
			"\t\t\t\tll pushed = dfs(e.to, t, min(flow, e.cap));",
			"\t\t\t\tif (pushed > 0) {",
			"\t\t\t\t\te.cap -= pushed;",
			"\t\t\t\t\tadj[e.to][e.rev].cap += pushed;",
			"\t\t\t\t\treturn pushed;",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn 0;",
			"\t}",
			"",
			"\tll max_flow(ll s, ll t) {",
			"\t\tll flow = 0;",
			"\t\twhile (bfs(s, t)) {",
			"\t\t\tfill(ptr.begin(), ptr.end(), 0);",
			"\t\t\twhile (ll pushed = dfs(s, t, LLONG_MAX)) {",
			"\t\t\t\tflow += pushed;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn flow;",
			"\t}",
			"",
			"\tvb min_cut_reachable(ll s) {",
			"\t\tvb visited(n, false);",
			"\t\tqueue<ll> q; q.push(s);",
			"\t\tvisited[s] = true;",
			"\t\twhile (!q.empty()) {",
			"\t\t\tll u = q.front(); q.pop();",
			"\t\t\tfor (auto &e : adj[u]) {",
			"\t\t\t\tif (e.cap > 0 && !visited[e.to]) {",
			"\t\t\t\t\tvisited[e.to] = true;",
			"\t\t\t\t\tq.push(e.to);",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn visited;",
			"\t}",
			"",
			"\tvpii get_min_cut_edges(ll s) {",
			"\t\tvpii cut_edges;",
			"\t\tvb visited = min_cut_reachable(s);",
			"",
			"\t\tfor (ll u = 0; u < n; u++) {",
			"\t\t\tif (visited[u]) {",
			"\t\t\t\tfor (auto &e : adj[u]) {",
			"\t\t\t\t\tif (!visited[e.to] && e.cap == 0) {",
			"\t\t\t\t\t\tcut_edges.emplace_back(u, e.to);",
			"\t\t\t\t\t}",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn cut_edges;",
			"\t}",
			"};"
		]
	}
}