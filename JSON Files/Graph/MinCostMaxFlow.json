{
	"MinCostMaxFlow": {
		"prefix": ["mcmf", "mincostmaxflow"],
		"body": [
			"struct Edge {",
			"\tll to, rev;",
			"\tll cap, cost;",
			"\tEdge(ll to, ll rev, ll cap, ll cost) : to(to), rev(rev), cap(cap), cost(cost) {}",
			"};",
			"",
			"struct MinCostMaxFlow {",
			"\tll n;",
			"\tvector<vector<Edge>> adj;",
			"\tvl dist, potential, parentNode, parentEdge;",
			"\tconst ll INF = 1e15;",
			"",
			"\tMinCostMaxFlow(ll n) : n(n) {",
			"\t\tadj.assign(n, vector<Edge>());",
			"\t\tdist.assign(n, INF);",
			"\t\tpotential.assign(n, 0);",
			"\t\tparentNode.assign(n, -1);",
			"\t\tparentEdge.assign(n, -1);",
			"\t}",
			"",
			"\tvoid add_edge(ll u, ll v, ll cap, ll cost) {",
			"\t\tadj[u].emplace_back(v, (ll)adj[v].size(), cap, cost);",
			"\t\tadj[v].emplace_back(u, (ll)adj[u].size() - 1, 0, -cost);",
			"\t}",
			"",
			"\tbool bellman_ford(ll s) {",
			"\t\tfill(potential.begin(), potential.end(), INF);",
			"\t\tpotential[s] = 0;",
			"\t\tbool updated;",
			"\t\tfor (ll iter = 0; iter < n - 1; iter++) {",
			"\t\t\tupdated = false;",
			"\t\t\tfor (ll u = 0; u < n; u++) {",
			"\t\t\t\tif (potential[u] == INF) continue;",
			"\t\t\t\tfor (auto &e : adj[u]) {",
			"\t\t\t\t\tif (e.cap > 0 && potential[u] + e.cost < potential[e.to]) {",
			"\t\t\t\t\t\tpotential[e.to] = potential[u] + e.cost;",
			"\t\t\t\t\t\tupdated = true;",
			"\t\t\t\t\t}",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t\tif (!updated) break;",
			"\t\t}",
			"\t\t// Optional: check for negative cycle here if needed.",
			"\t\treturn true;",
			"\t}",
			"",
			"\tbool dijkstra(ll s, ll t) {",
			"\t\tfill(dist.begin(), dist.end(), INF);",
			"\t\tdist[s] = 0;",
			"",
			"\t\tusing pli = pair<ll, ll>;",
			"\t\tpriority_queue<pli, vector<pli>, greater<pli>> pq;",
			"\t\tpq.push({0, s});",
			"",
			"\t\twhile (!pq.empty()) {",
			"\t\t\tauto [d, u] = pq.top(); pq.pop();",
			"\t\t\tif (d != dist[u]) continue;",
			"\t\t\tif (u == t) return true;",
			"",
			"\t\t\tfor (ll i = 0; i < (ll)adj[u].size(); i++) {",
			"\t\t\t\tEdge &e = adj[u][i];",
			"\t\t\t\tif (e.cap > 0) {",
			"\t\t\t\t\tll cost_with_pot = e.cost + potential[u] - potential[e.to];",
			"\t\t\t\t\tif (dist[u] + cost_with_pot < dist[e.to]) {",
			"\t\t\t\t\t\tdist[e.to] = dist[u] + cost_with_pot;",
			"\t\t\t\t\t\tparentNode[e.to] = u;",
			"\t\t\t\t\t\tparentEdge[e.to] = i;",
			"\t\t\t\t\t\tpq.push({dist[e.to], e.to});",
			"\t\t\t\t\t}",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn false;",
			"\t}",
			"",
			"\tpii min_cost_max_flow(ll s, ll t) {",
			"\t\tll flow = 0, cost = 0;",
			"",
			"\t\t// If Negative Costs Run Bellman-Ford once to properly Initialize Potentials for Dijkstra",
			"\t\t// bellman_ford(s);",
			"",
			"\t\t// If Positive Costs Initializing Potentials Zero for Dijkstra",
			"\t\tfill(potential.begin(), potential.end(), 0);",
			"",
			"\t\twhile (dijkstra(s, t)) {",
			"\t\t\tfor (ll i = 0; i < n; i++) {",
			"\t\t\t\tif (dist[i] < INF)",
			"\t\t\t\t\tpotential[i] += dist[i];",
			"\t\t\t}",
			"",
			"\t\t\tll pushed = LLONG_MAX;",
			"\t\t\tfor (ll v = t; v != s; v = parentNode[v]) {",
			"\t\t\t\tll u = parentNode[v];",
			"\t\t\t\tll idx = parentEdge[v];",
			"\t\t\t\tpushed = min(pushed, adj[u][idx].cap);",
			"\t\t\t}",
			"",
			"\t\t\tfor (ll v = t; v != s; v = parentNode[v]) {",
			"\t\t\t\tll u = parentNode[v];",
			"\t\t\t\tll idx = parentEdge[v];",
			"\t\t\t\tadj[u][idx].cap -= pushed;",
			"\t\t\t\tadj[v][adj[u][idx].rev].cap += pushed;",
			"\t\t\t\tcost += pushed * adj[u][idx].cost;",
			"\t\t\t}",
			"",
			"\t\t\tflow += pushed;",
			"\t\t}",
			"\t\treturn {flow, cost};",
			"\t}",
			"};"
		]
	}
}