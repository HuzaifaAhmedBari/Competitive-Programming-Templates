{
    "LCA_Binary_Lifting": {
		"prefix": ["lca", "LCA", "binarylifting"],
		"body": [
			"struct LCA {",
			"\tll n;",
			"\tvl depth;",
			"\tvll adj, up;",
			"\tconst ll LOG = 20;",
			"",
			"\tLCA(ll nodes) : n(nodes) {",
			"\t\tadj.assign(n, vl());",
			"\t\tdepth.assign(n, 0);",
			"\t\tup.assign(n, vl(LOG, -1));",
			"\t}",
			"",
			"\tvoid add_edge(ll u, ll v) {",
			"\t\tadj[u].push_back(v);",
			"\t\tadj[v].push_back(u);",
			"\t}",
			"",
			"\tvoid dfs(ll u, ll p) {",
			"\t\tup[u][0] = p;",
			"\t\tfori(1, LOG) {",
			"\t\t\tif (up[u][i-1] == -1)",
			"\t\t\t\tup[u][i] = -1;",
			"\t\t\telse",
			"\t\t\t\tup[u][i] = up[up[u][i-1]][i-1];",
			"\t\t}",
			"\t\tfor (ll v : adj[u]) {",
			"\t\t\tif (v == p) continue;",
			"\t\t\tdepth[v] = depth[u] + 1;",
			"\t\t\tdfs(v, u);",
			"\t\t}",
			"\t}",
			"",
			"\tvoid init(ll root = 0) {",
			"\t\tdepth[root] = 0;",
			"\t\tdfs(root, -1);",
			"\t}",
			"",
			"\tll lift_node(ll u, ll k) {",
			"\t\tfori(0, LOG) {",
			"\t\t\tif (k & (1LL << i)) {",
			"\t\t\t\tif (u == -1) return -1;",
			"\t\t\t\tu = up[u][i];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn u;",
			"\t}",
			"",
			"\tll lca(ll u, ll v) {",
			"\t\tif (depth[u] < depth[v]) swap(u, v);",
			"\t\tu = lift_node(u, depth[u] - depth[v]);",
			"\t\tif (u == v) return u;",
			"\t\tfor (ll i = LOG - 1; i >= 0; i--) {",
			"\t\t\tif (up[u][i] != up[v][i]) {",
			"\t\t\t\tu = up[u][i];",
			"\t\t\t\tv = up[v][i];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn up[u][0];",
			"\t}",
			"};"
		]
	}
}