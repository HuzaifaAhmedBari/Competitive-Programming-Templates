            "",
            "void update_node(ll u, ll new_val, HLD &hld, SegmentTree &seg) {",
            "\thld.value[u] = new_val;",
            "\tseg.update(hld.pos[u], new_val);",
            "}",
            "void update_edge(ll u, ll v, ll new_val, HLD &hld, SegmentTree &seg) {",
            "\tif (hld.depth[u] > hld.depth[v]) ",
            "\t\tswap(u, v);  // now v is deeper node",
            "",
            "\t// Update the value at the deeper node v",
            "\thld.value[v] = new_val;",
            "",
            "\t// Update the segment tree at position pos[v]",
            "\tseg.update(hld.pos[v], new_val);",
            "}",
            "",
            "void update_path(ll u, ll v, ll new_val, HLD &hld, SegmentTree &seg) {",
            "\twhile (hld.head[u] != hld.head[v]) {",
            "\t\tif (hld.depth[hld.head[u]] < hld.depth[hld.head[v]])",
            "\t\t\tswap(u, v);",
            "\t\tll top = hld.head[u];",
            "\t\tseg.update(hld.pos[top], hld.pos[u], new_val); // range set on segment tree",
            "\t\tu = hld.parent[top];",
            "\t}",
            "\tif (hld.depth[u] > hld.depth[v]) swap(u, v);",
            "\tseg.update(hld.pos[u], hld.pos[v], new_val);",
            "}",
            "ll query_path(ll a, ll b, HLD &hld, SegTree &seg) {",
            "\tll res = 0;",
            "",
            "\twhile (hld.head[a] != hld.head[b]) {",
            "\t\tif (hld.depth[hld.head[a]] < hld.depth[hld.head[b]])",
            "\t\t\tswap(a, b);",
            "",
            "\t\tll top = hld.head[a];",
            "\t\tres += seg.query(hld.pos[top], hld.pos[a]);",
            "\t\ta = hld.parent[top];",
            "\t}",
            "",
            "\tif (hld.depth[a] > hld.depth[b])",
            "\t\tswap(a, b);",
            "",
            "\t// If nodes have values",
            "\tres += seg.query(hld.pos[a], hld.pos[b]);",
            "",
            "\t// If edges have values",
            "\t//res += seg.query(hld.pos[a] + 1, hld.pos[b]);",
            "",
