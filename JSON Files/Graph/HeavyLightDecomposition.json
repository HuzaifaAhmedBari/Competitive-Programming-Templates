		"body": [
            "struct HLD {",
            "\tll n, cur_pos = 0;",
            "\tvector<vector<ll>> g;",
            "\tvector<ll> parent, depth, heavy, head, pos, sz;",
            "\tvector<ll> value; // node values",
            "",
            "\tHLD(ll n) : n(n), g(n), parent(n), depth(n),",
            "\t\t\t heavy(n, -1), head(n), pos(n), sz(n), value(n) {}",
            "",
            "\tvoid addEdge(ll u, ll v) {",
            "\t\tg[u].push_back(v);",
            "\t\tg[v].push_back(u);",
            "\t}",
            "",
            "\tll dfs(ll u, ll p) {",
            "\t\tparent[u] = p;",
            "\t\tsz[u] = 1;",
            "\t\tll max_sz = 0;",
            "",
            "\t\tfor (ll v : g[u]) if (v != p) {",
            "\t\t\tdepth[v] = depth[u] + 1;",
            "\t\t\tll sub = dfs(v, u);",
            "\t\t\tsz[u] += sub;",
            "\t\t\tif (sub > max_sz) {",
            "\t\t\t\tmax_sz = sub;",
            "\t\t\t\theavy[u] = v;",
            "\t\t\t}",
            "\t\t}",
            "\t\treturn sz[u];",
            "\t}",
            "",
            "\tvoid decompose(ll u, ll h) {",
            "\t\thead[u] = h;",
            "\t\tpos[u] = cur_pos++;",
            "",
            "\t\tif (heavy[u] != -1)",
            "\t\t\tdecompose(heavy[u], h);",
            "",
            "\t\tfor (ll v : g[u]) {",
            "\t\t\tif (v != parent[u] && v != heavy[u])",
            "\t\t\t\tdecompose(v, v);",
            "\t\t}",
            "\t}",
            "",
            "\tvoid init(ll root = 0) {",
            "\t\tdfs(root, -1);",
            "\t\tdecompose(root, root);",
            "\t}",
            "};",
            "",
