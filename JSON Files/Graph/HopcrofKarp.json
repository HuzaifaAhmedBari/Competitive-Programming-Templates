{
    "Hopcroft Karp Bipartite Matching": {
		"prefix": ["hopcroftkarp", "HK"],
		"body": [
			"struct HopcroftKarp {",
			"\tll n, m;                // n = size of left set, m = size of right set",
			"\tvll adj;                // adjacency list from left to right",
			"\tvl dist, matchL, matchR;",
			"",
			"\tHopcroftKarp(ll n, ll m) : n(n), m(m) {",
			"\t\tadj.resize(n);",
			"\t\tdist.resize(n);",
			"\t\tmatchL.assign(n, -1);",
			"\t\tmatchR.assign(m, -1);",
			"\t}",
			"",
			"\tvoid addEdge(ll u, ll v) {",
			"\t\tadj[u].push_back(v);",
			"\t}",
			"",
			"\tbool bfs() {",
			"\t\tqueue<ll> q;",
			"\t\tfor (ll u = 0; u < n; u++) {",
			"\t\t\tif (matchL[u] == -1) {",
			"\t\t\t\tdist[u] = 0;",
			"\t\t\t\tq.push(u);",
			"\t\t\t} else {",
			"\t\t\t\tdist[u] = INT_MAX;",
			"\t\t\t}",
			"\t\t}",
			"",
			"\t\tbool found = false;",
			"",
			"\t\twhile (!q.empty()) {",
			"\t\t\tll u = q.front(); q.pop();",
			"\t\t\tfor (ll v : adj[u]) {",
			"\t\t\t\tll w = matchR[v];",
			"\t\t\t\tif (w == -1) {",
			"\t\t\t\t\tfound = true;",
			"\t\t\t\t} else if (dist[w] == INT_MAX) {",
			"\t\t\t\t\tdist[w] = dist[u] + 1;",
			"\t\t\t\t\tq.push(w);",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn found;",
			"\t}",
			"",
			"\tbool dfs(ll u) {",
			"\t\tfor (ll v : adj[u]) {",
			"\t\t\tll w = matchR[v];",
			"\t\t\tif (w == -1 || (dist[w] == dist[u] + 1 && dfs(w))) {",
			"\t\t\t\tmatchL[u] = v;",
			"\t\t\t\tmatchR[v] = u;",
			"\t\t\t\treturn true;",
			"\t\t\t}",
			"\t\t}",
			"\t\tdist[u] = INT_MAX;",
			"\t\treturn false;",
			"\t}",
			"",
			"\tll maxMatching() {",
			"\t\tll matching = 0;",
			"\t\twhile (bfs()) {",
			"\t\t\tfor (ll u = 0; u < n; u++) {",
			"\t\t\t\tif (matchL[u] == -1 && dfs(u))",
			"\t\t\t\t\tmatching++;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn matching;",
			"\t}",
			"};"
		]
	}
}