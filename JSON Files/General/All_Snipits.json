	"Topological Sort with DP": {
		"prefix": ["Topsort", "topsort"],
		"body": [
			"vl parent;",
			"vl topo, dist;",
			"bool topsort(ll n, const vll &adj, ll source = 0) {",
			"\tll count = 0;",
			"\tvl indegree(n+1, 0);",
			"\tdist.assign(n+1, LLONG_MIN);",
			"\tdist[source] = 0;",
			"",
			"\tfor(ll u = 0; u < n; u++)", 
			"\t\tfor (int v : adj[u])",
			"\t\t\tindegree[v]++;",
			"",
			"\tqueue<ll> q;",
			"\tfori(0,n)",
			"\t\tif(indegree[i]==0)",
			"\t\t\tq.push(i);",
			"",
			"\twhile (!q.empty()) {",
			"\t\tll u = q.front();",
			"\t\tq.pop();",
			"\t\ttopo.push_back(u);",
			"",
			"\t\tfor (ll v : adj[u]) {",
			"\t\t\t// if(dist[u] != LLONG_MIN)",
			"\t\t\t// \tdist[v] = max(dist[v], dist[u] + 1);",
			"\t\t\t// +1 for unweighted edge or use weight for weighted DAG",
			"",
			"\t\t\tif (--indegree[v] == 0)",
			"\t\t\t\tq.push(v);",
			"\t\t}",
			"\t\tcount++;",
			"\t}",
			"\treturn count != n; // True means cycle exists",
			"}"
		],
		"description": "Performs Topological Sort on a DAG using Kahn's algorithm (BFS with indegree). Also supports DP on DAG (e.g., longest path computation). Returns true if a cycle exists, false otherwise."
	},
	"Dijkstra Function": {
		"prefix": ["dijkstra" , "Dijkstra"],
		"body": [
			"vl parent;",
			"vl dijkstra(ll n, ll source, vvpii &adj)",
			"{",
			"\tvl dist(n, LLONG_MAX);",
			"\tdist[source] = 0;",
			"",
			"\tpriority_queue<pii, vpii, greater<>> pq;",
			"\tpq.push({0, source});",
			"",
			"\twhile (!pq.empty())",
			"\t{",
			"\t\tauto [d, u] = pq.top(); pq.pop();",
			"\t\tif(d > dist[u])",
			"\t\t\tcontinue;",
			"",
			"\t\tfor (auto [v, w] : adj[u])",
			"\t\t{",
			"\t\t\tif(dist[u] + w < dist[v])",
			"\t\t\t{",
			"\t\t\t\tdist[v] = dist[u] + w;",
			"\t\t\t\tpq.push({dist[v], v});",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"\treturn dist;",
			"}",
            "vl getPath(ll target) {",
            "\tvl path;",
            "\tfor (ll v = target; v != -1; v = parent[v])",
            "\t\tpath.push_back(v);",
            "",
            "\treverse(path.begin(), path.end());",
            "\treturn path;",
            "}"
		],
		"description": "Dijkstra's algorithm for single-source shortest paths in O((N+M) log N). Includes path reconstruction using a parent array."
	},
	"Bellman-Ford with Negative Cycle Detection": {
		"prefix": ["Bellmanford" , "bellmanford"],
		"body": [
			"vl dist, parent, cycle;",
			"",
			"struct Edge {",
			"\tll u, v, w;",
			"};",
			"",
			"bool bellman_ford(ll n, ll source, const vector<Edge> &edges) {",
			"\tdist.assign(n+1, LLONG_MAX);",
			"\tparent.assign(n+1, -1);",
			"\tdist[source] = 0;",
			"",
			"\tfor(ll i = 0; i < n - 1; ++i) {",
			"\t\tfor (const Edge &e : edges) {",
			"\t\t\tif (dist[e.u] < LLONG_MAX && dist[e.u] + e.w < dist[e.v]) {",
			"\t\t\t\tdist[e.v] = dist[e.u] + e.w;",
			"\t\t\t\tparent[e.v] = e.u;",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"",
			"\t// Detect negative cycle",
			"\tfor (const Edge &e : edges) {",
			"\t\tif (dist[e.u] < LLONG_MAX && dist[e.u] + e.w < dist[e.v]) {",
			"\t\t\treturn false; // Negative cycle found",
			"\t\t}",
			"\t}",
			"",
			"\treturn true; // No negative cycle",
			"}",
			"",
			"vl get_path(ll target) {",
			"\tvl path;",
			"\tfor (ll v = target; v != -1; v = parent[v])",
			"\t\tpath.push_back(v);",
			"\treverse(path.begin(), path.end());",
			"\treturn path;",
			"}",
			"",
			"bool find_negative_cycle(ll n, const vector<Edge> &edges) {",
			"\tll x = -1;",
			"",
			"\tfor (const Edge &e : edges) {",
			"\t\tif (dist[e.u] + e.w < dist[e.v]) {",
			"\t\t\tdist[e.v] = dist[e.u] + e.w;",
			"\t\t\tparent[e.v] = e.u;",
			"\t\t\tx = e.v;",
			"\t\t}",
			"\t}",
			"",
			"\tif (x == -1)",
			"\t\treturn false; // No negative cycle",
			"",
			"\t// Recover the cycle",
			"\tfor (ll i = 0; i < n; ++i)",
			"\t\tx = parent[x]; // x is guaranteed to be inside the cycle",
			"",
			"\tll cur = x;",
			"\tcycle.push_back(cur);",
			"\twhile (true) {",
			"\t\tcur = parent[cur];",
			"\t\tcycle.push_back(cur);",
			"\t\tif (cur == x && cycle.size() > 1)",
			"\t\t\tbreak;",
			"\t}",
			"\treverse(cycle.begin(), cycle.end());",
			"\treturn true;",
			"}"
		],
		"description": "Bellman-Ford algorithm for single-source shortest paths in O(N*M). Supports path retrieval and detects negative weight cycles, with functionality to reconstruct the cycle if it exists."
	},
	"Floyd Warshall with Negative Cycle Detection": {
		"prefix": ["Floydwarshall" , "floydwarshall"],
		"body": [
			"void floyd_warshall(ll n, vll &dist) {",
			"\tfori(0,n)",
			"\t\tdist[i][i] = 0;",
			"",
			"\tfor (ll k = 0; k < n; ++k)",
			"\t{",
			"\t\tfor (ll i = 0; i < n; ++i)",
			"\t\t{",
			"\t\t\tfor (ll j = 0; j < n; ++j)",
			"\t\t\t{",
			"\t\t\t\tif(dist[i][k] < LLONG_MIN && dist[k][j] < LLONG_MIN)",
			"\t\t\t\t\tdist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j]);",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"}",
			"",
			"bool has_negative_cycle(ll n, vll &dist) {",
			"\tfor (ll i = 0; i < n; ++i)",
			"\t{",
			"\t\tif(dist[i][i] < 0)",
			"\t\t\treturn true;",
			"\t}",
			"\treturn false;",
			"}"
		],
		"description": "Floyd-Warshall algorithm for all-pairs shortest paths in O(N^3). Also detects negative weight cycles by checking if any dist[i][i] < 0 after relaxation."
	},
	"TarjanSCC for Bridges And Articulation Points": {
		"prefix": ["Tarjan" , "tarjan" , "Bridges" , "bridges"],
		"body": [
			"struct Tarjan {",
			"\tll n, timer;",
			"\tvll adj;",
			"\tvl tin, low, isArticulation;",
			"\tvpii bridges;",
			"",
			"\tTarjan(ll n) : n(n) {",
			"\t\tadj.assign(n, {});",
			"\t\ttin.assign(n, -1);",
			"\t\tlow.assign(n, -1);",
			"\t\tisArticulation.assign(n, 0);",
			"\t\ttimer = 0;",
			"\t}",
			"",
			"\tvoid add_edge(ll u, ll v) {",
			"\t\tadj[u].push_back(v);",
			"\t\tadj[v].push_back(u); // undirected graph",
			"\t}",
			"",
			"\tvoid dfs(ll v, ll p = -1) {",
			"\t\ttin[v] = low[v] = timer++;",
			"\t\tll children = 0;",
			"",
			"\t\tfor (ll u : adj[v])",
			"\t\t{",
			"\t\t\tif(u==p)",
			"\t\t\t\tcontinue;",
			"",
			"\t\t\tif(tin[u] != -1)",
			"\t\t\t{",
			"\t\t\t\t// back edge",
			"\t\t\t\tlow[v] = min(low[v], tin[u]);",
			"\t\t\t}",
			"\t\t\telse",
			"\t\t\t{",
			"\t\t\t\t// tree edge",
			"\t\t\t\tdfs(u, v);",
			"",
			"\t\t\t\tlow[v] = min(low[v], low[u]);",
			"",
			"\t\t\t\tif (low[u] > tin[v])",
			"\t\t\t\t{",
			"\t\t\t\t\t// v-u is a bridge",
			"\t\t\t\t\tbridges.push_back({v, u});",
			"\t\t\t\t}",
			"\t\t\t\tif(low[u] >= tin[v] && p != -1)",
			"\t\t\t\t{",
			"\t\t\t\t\t// v is an articulation point (not root)",
			"\t\t\t\t\tisArticulation[v] = 1;",
			"\t\t\t\t}",
			"\t\t\t\tchildren++;",
			"\t\t\t}",
			"\t\t}",
			"",
			"\t\tif (p==-1 && children>1)",
			"\t\t{",
			"\t\t\t// root articulation point",
			"\t\t\tisArticulation[v] = 1;",
			"\t\t}",
			"\t}",
			"",
			"\tvoid run() {",
			"\t\tfori(0,n)",
			"\t\t{",
			"\t\t\tif (tin[i] == -1)",
			"\t\t\t\tdfs(i);",
			"\t\t}",
			"\t}",
			"};"
		],
		"description": "Tarjan's DFS-based algorithm to find Bridges and Articulation Points in an undirected graph in O(N+M). Uses discovery time (tin) and low-link values (low) to detect critical edges and cut vertices. Handles disconnected graphs too."
	},
	"DSU Class": {
		"prefix": ["Dsuclass" , "dsuclass" , "Disjoint" , "disjoint"],
		"body": [
			"class DSU {",
			"public:",
			"\tll n, components;",
			"\tvl parent, size;",
			"",
			"\tDSU(int n) : n(n), components(n) {",
			"\t\tparent.resize(n+1);",
			"\t\tsize.resize(n+1, 1);",
			"\t\tiota(all(parent), 0);",
			"\t}",
			"",
			"\tll find(ll x) {",
			"\t\tif (parent[x] != x)",
			"\t\t\tparent[x] = find(parent[x]);",
			"\t\treturn parent[x];",
			"\t}",
			"",
			"\tbool unite(ll a, ll b) {",
			"\t\ta = find(a);",
			"\t\tb = find(b);",
			"\t\tif (a == b)",
			"\t\t\treturn false;",
			"",
			"\t\tif (size[a] < size[b])",
			"\t\t\tswap(a, b);",
			"\t\tparent[b] = a;",
			"\t\tsize[a] += size[b];",
			"\t\tcomponents--;",
			"\t\treturn true;",
			"\t}",
			"",
			"\tbool connected(ll a, ll b) {",
			"\t\treturn find(a) == find(b);",
			"\t}",
			"",
			"\tll getSize(ll x) {",
			"\t\treturn size[find(x)];",
			"\t}",
			"};"
		],
		"description": "Disjoint Set Union (Union-Find) data structure with path compression and union by size. Supports find, unite, connectivity check, component count, and set size queries efficiently."
	},
	"Prim's MST": {
		"prefix": ["Prim" , "prim"],
		"body": [
			"vb visited;",
			"vl min_edge, parent;",
			"",
			"ll prim(ll n, vector<vector<pii>> &adj) {",
			"\tvisited.assign(n+1, false);",
			"\tmin_edge.assign(n+1, LLONG_MIN);",
			"\tparent.assign(n+1, -1);",
			"",
			"\tll total_weight = 0;",
			"\tpriority_queue<pii, vector<pii>, greater<>> pq;",
			"",
			"\tmin_edge[0] = 0;        // Change for 1-based indexing",
			"\tpq.push({0, 0});        // {weight, node}",
			"",
			"\twhile (!pq.empty())",
			"\t{",
			"\t\tauto [w, u] = pq.top();",
			"\t\tpq.pop();",
			"\t\tif(visited[u])",
			"\t\t\tcontinue;",
			"",
			"\t\tvisited[u] = true;",
			"\t\ttotal_weight += w;",
			"",
			"\t\tfor (auto [v, weight] : adj[u])",
			"\t\t{",
			"\t\t\tif (!visited[v] && weight < min_edge[v])",
			"\t\t\t{",
			"\t\t\t\tmin_edge[v] = weight;",
			"\t\t\t\tparent[v] = u;",
			"\t\t\t\tpq.push({weight, v});",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"\treturn total_weight;",
			"}"
		],
		"description": "Prim's algorithm for finding the Minimum Spanning Tree (MST) of a weighted undirected graph. Uses a priority queue to greedily select the next minimum edge. Tracks visited nodes, parent links, and accumulates the total MST weight."
	},
	"Kruskal's MST": {
        "prefix": ["Kruskal" , "kruskal"],
        "body": [
            "struct Edge {",
            "\tll u, v, w;",
            "\tbool operator<(const Edge &e) const {",
            "\t\treturn w < e.w;",
            "\t}",
            "};",
            "",
            "ll kruskal(ll n, vector<Edge> &edges) {",
            "\tsort(edges.begin(), edges.end());",
            "\tDSU dsu(n);",
            "\tll total_weight = 0;",
            "",
            "\tfor (auto &e : edges) {",
            "\t\tif (dsu.unite(e.u, e.v)) {",
            "\t\t\ttotal_weight += e.w;",
            "\t\t\t// store edge (e.u, e.v) if needed",
            "\t\t}",
            "\t}",
            "\treturn total_weight;",
            "}"
        ],
		"description": "Kruskal's algorithm for finding the Minimum Spanning Tree (MST) of a weighted undirected graph. Uses Disjoint Set Union (DSU) to efficiently check connectivity and avoid cycles. Sorts edges by weight and greedily adds them to form the MST, returning the total weight."
    },
	"Hopcroft Karp Bipartite Matching": {
		"prefix": ["hopcroftkarp", "HK"],
		"body": [
			"struct HopcroftKarp {",
			"\tll n, m;                // n = size of left set, m = size of right set",
			"\tvll adj;                // adjacency list from left to right",
			"\tvl dist, matchL, matchR;",
			"",
			"\tHopcroftKarp(ll n, ll m) : n(n), m(m) {",
			"\t\tadj.resize(n);",
			"\t\tdist.resize(n);",
			"\t\tmatchL.assign(n, -1);",
			"\t\tmatchR.assign(m, -1);",
			"\t}",
			"",
			"\tvoid addEdge(ll u, ll v) {",
			"\t\tadj[u].push_back(v);",
			"\t}",
			"",
			"\tbool bfs() {",
			"\t\tqueue<ll> q;",
			"\t\tfor (ll u = 0; u < n; u++) {",
			"\t\t\tif (matchL[u] == -1) {",
			"\t\t\t\tdist[u] = 0;",
			"\t\t\t\tq.push(u);",
			"\t\t\t} else {",
			"\t\t\t\tdist[u] = INT_MAX;",
			"\t\t\t}",
			"\t\t}",
			"",
			"\t\tbool found = false;",
			"",
			"\t\twhile (!q.empty()) {",
			"\t\t\tll u = q.front(); q.pop();",
			"\t\t\tfor (ll v : adj[u]) {",
			"\t\t\t\tll w = matchR[v];",
			"\t\t\t\tif (w == -1) {",
			"\t\t\t\t\tfound = true;",
			"\t\t\t\t} else if (dist[w] == INT_MAX) {",
			"\t\t\t\t\tdist[w] = dist[u] + 1;",
			"\t\t\t\t\tq.push(w);",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn found;",
			"\t}",
			"",
			"\tbool dfs(ll u) {",
			"\t\tfor (ll v : adj[u]) {",
			"\t\t\tll w = matchR[v];",
			"\t\t\tif (w == -1 || (dist[w] == dist[u] + 1 && dfs(w))) {",
			"\t\t\t\tmatchL[u] = v;",
			"\t\t\t\tmatchR[v] = u;",
			"\t\t\t\treturn true;",
			"\t\t\t}",
			"\t\t}",
			"\t\tdist[u] = INT_MAX;",
			"\t\treturn false;",
			"\t}",
			"",
			"\tll maxMatching() {",
			"\t\tll matching = 0;",
			"\t\twhile (bfs()) {",
			"\t\t\tfor (ll u = 0; u < n; u++) {",
			"\t\t\t\tif (matchL[u] == -1 && dfs(u))",
			"\t\t\t\t\tmatching++;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn matching;",
			"\t}",
			"};"
		],
		"description": "Hopcroft-Karp algorithm for maximum bipartite matching in O(E * sqrt(V)). Uses BFS to build layers and DFS to find augmenting paths. Left set size = n, right set size = m."
	},
  	"LCA_Binary_Lifting": {
		"prefix": ["lca", "LCA", "binarylifting"],
		"body": [
			"struct LCA {",
			"\tll n;",
			"\tvl depth;",
			"\tvll adj, up;",
			"\tconst ll LOG = 20;",
			"",
			"\tLCA(ll nodes) : n(nodes) {",
			"\t\tadj.assign(n, vl());",
			"\t\tdepth.assign(n, 0);",
			"\t\tup.assign(n, vl(LOG, -1));",
			"\t}",
			"",
			"\tvoid add_edge(ll u, ll v) {",
			"\t\tadj[u].push_back(v);",
			"\t\tadj[v].push_back(u);",
			"\t}",
			"",
			"\tvoid dfs(ll u, ll p) {",
			"\t\tup[u][0] = p;",
			"\t\tfori(1, LOG) {",
			"\t\t\tif (up[u][i-1] == -1)",
			"\t\t\t\tup[u][i] = -1;",
			"\t\t\telse",
			"\t\t\t\tup[u][i] = up[up[u][i-1]][i-1];",
			"\t\t}",
			"\t\tfor (ll v : adj[u]) {",
			"\t\t\tif (v == p) continue;",
			"\t\t\tdepth[v] = depth[u] + 1;",
			"\t\t\tdfs(v, u);",
			"\t\t}",
			"\t}",
			"",
			"\tvoid init(ll root = 0) {",
			"\t\tdepth[root] = 0;",
			"\t\tdfs(root, -1);",
			"\t}",
			"",
			"\tll lift_node(ll u, ll k) {",
			"\t\tfori(0, LOG) {",
			"\t\t\tif (k & (1LL << i)) {",
			"\t\t\t\tif (u == -1) return -1;",
			"\t\t\t\tu = up[u][i];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn u;",
			"\t}",
			"",
			"\tll lca(ll u, ll v) {",
			"\t\tif (depth[u] < depth[v]) swap(u, v);",
			"\t\tu = lift_node(u, depth[u] - depth[v]);",
			"\t\tif (u == v) return u;",
			"\t\tfor (ll i = LOG - 1; i >= 0; i--) {",
			"\t\t\tif (up[u][i] != up[v][i]) {",
			"\t\t\t\tu = up[u][i];",
			"\t\t\t\tv = up[v][i];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn up[u][0];",
			"\t}",
			"};"
			],
			"description": "LCA (Lowest Common Ancestor) with Binary Lifting technique for efficient ancestor queries in O(log n). Supports initialization, adding edges, and queries."
	},
	"Segment Tree with Lazy (Set/Add)": {
		"prefix": ["Segtree" , "segtree" , "segmenttree"],
		"body": [
			"struct Node {",
			"\tll val = 0;",
			"",
			"\tNode() {}",
			"\tNode(ll v) : val(v) {}",
			"",
			"\t// Change The Merge Function According to Segments Overlap Required",
			"\tstatic Node merge(const Node &a, const Node &b) {",
			"\t\treturn Node(a.val + b.val);",
			"\t}",
			"};",
			"",
			"class SegmentTree {",
			"\tll n;",
			"\tvector<Node> tree;",
			"\tvl arr, lazy;",
			"\tvb has_lazy;",
			"",
			"public:",
			"\tSegmentTree(const vl &input) {",
			"\t\tarr = input;",
			"\t\tn = arr.size();",
			"\t\ttree.assign(4 * n, Node());",
			"\t\tlazy.assign(4 * n, 0);",
			"\t\thas_lazy.assign(4 * n, false);",
			"\t\tbuild(1, 0, n - 1);",
			"\t}",
			"",
			"private:",
			"\tvoid build(ll idx, ll l, ll r) {",
			"\t\tif (l == r) {",
			"\t\t\ttree[idx] = Node(arr[l]);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tll mid = (l + r) / 2;",
			"\t\tbuild(2 * idx, l, mid);",
			"\t\tbuild(2 * idx + 1, mid + 1, r);",
			"\t\ttree[idx] = Node::merge(tree[2 * idx], tree[2 * idx + 1]);",
			"\t}",
			"",
			"\tvoid apply(ll idx, ll l, ll r, ll val) {",
			"\t\t// ----- Set operation -----",
			"\t\ttree[idx] = Node((r - l + 1) * val);",
			"\t\tlazy[idx] = val;",
			"\t\thas_lazy[idx] = true;",
			"",
			"\t\t// ----- Add operation -----",
			"\t\t// tree[idx].val += (r - l + 1) * val;",
			"\t\t// lazy[idx] += val;",
			"\t\t// has_lazy[idx] = true;",
			"\t}",
			"",
			"\tvoid push(ll idx, ll l, ll r) {",
			"\t\tif (!has_lazy[idx] || l == r) return;",
			"\t\tll mid = (l + r) / 2;",
			"\t\tapply(2 * idx, l, mid, lazy[idx]);",
			"\t\tapply(2 * idx + 1, mid + 1, r, lazy[idx]);",
			"\t\tlazy[idx] = 0;",
			"\t\thas_lazy[idx] = false;",
			"\t}",
			"",
			"\tvoid update_range(ll ql, ll qr, ll val, ll idx, ll l, ll r) {",
			"\t\tpush(idx, l, r);",
			"\t\tif (qr < l || r < ql) return;",
			"\t\tif (ql <= l && r <= qr) {",
			"\t\t\tapply(idx, l, r, val);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tll mid = (l + r) / 2;",
			"\t\tupdate_range(ql, qr, val, 2 * idx, l, mid);",
			"\t\tupdate_range(ql, qr, val, 2 * idx + 1, mid + 1, r);",
			"\t\ttree[idx] = Node::merge(tree[2 * idx], tree[2 * idx + 1]);",
			"\t}",
			"",
			"\tvoid update_point(ll pos, ll val, ll idx, ll l, ll r) {",
			"\t\tpush(idx, l, r);",
			"\t\tif (l == r) {",
			"\t\t\ttree[idx] = Node(val);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tll mid = (l + r) / 2;",
			"\t\tif (pos <= mid)",
			"\t\t\tupdate_point(pos, val, 2 * idx, l, mid);",
			"\t\telse",
			"\t\t\tupdate_point(pos, val, 2 * idx + 1, mid + 1, r);",
			"\t\ttree[idx] = Node::merge(tree[2 * idx], tree[2 * idx + 1]);",
			"\t}",
			"",
			"\tNode query(ll ql, ll qr, ll idx, ll l, ll r) {",
			"\t\tpush(idx, l, r);",
			"\t\tif(qr < l || r < ql)",
			"\t\t\treturn Node();",
			"\t\tif(ql <= l && r <= qr)",
			"\t\t\treturn tree[idx];",
			"\t\tll mid = (l + r) / 2;",
			"\t\treturn Node::merge(",
			"\t\t\tquery(ql, qr, 2 * idx, l, mid),",
			"\t\t\tquery(ql, qr, 2 * idx + 1, mid + 1, r)",
			"\t\t);",
			"\t}",
			"",
			"public:",
			"\t// Public interfaces",
			"\tvoid update(ll l, ll r, ll val) { update_range(l, r, val, 1, 0, n - 1); }     // range update",
			"\tvoid update(ll pos, ll val) { update_point(pos, val, 1, 0, n - 1); }          // point update",
			"\tll query(ll l, ll r) { return query(l, r, 1, 0, n - 1).val; }",
			"};"
		],
		"description": "Segment Tree implementation with lazy propagation supporting both range updates (set or add operations) and queries. Provides point update, range update, and range query functionalities. The merge function can be customized depending on the required segment operation (e.g., sum, min, max)."
	},
	"Bit Trie Full Template": {
		"prefix": ["BitTrie" , "bittrie"],
		"body": [
			"struct BitTrieNode {",
			"\tBitTrieNode* next[2];",
			"\tBitTrieNode() {",
			"\t\tnext[0] = next[1] = nullptr;",
			"\t}",
			"};",
			"",
			"struct BitTrie {",
			"\tBitTrieNode* root;",
			"\tstatic const int BITS = 31; // for int (use 63 for long long)",
			"",
			"\tBitTrie() {",
			"\t\troot = new BitTrieNode();",
			"\t}",
			"",
			"\t// Insert number into trie",
			"\tvoid insert(long long num) {",
			"\t\tBitTrieNode* node = root;",
			"\t\tfor(int i = BITS; i >= 0; i--) {",
			"\t\t\tint b = (num >> i) & 1;",
			"\t\t\tif(!node->next[b]) node->next[b] = new BitTrieNode();",
			"\t\t\tnode = node->next[b];",
			"\t\t}",
			"\t}",
			"",
			"\t// Query maximum number stored",
			"\tlong long getMax() {",
			"\t\tBitTrieNode* node = root;",
			"\t\tlong long ans = 0;",
			"\t\tfor(int i = BITS; i >= 0; i--) {",
			"\t\t\tif(node->next[1]) {",
			"\t\t\t\tans |= (1LL << i);",
			"\t\t\t\tnode = node->next[1];",
			"\t\t\t} else if(node->next[0]) {",
			"\t\t\t\tnode = node->next[0];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"",
			"\t// Query minimum number stored",
			"\tlong long getMin() {",
			"\t\tBitTrieNode* node = root;",
			"\t\tlong long ans = 0;",
			"\t\tfor(int i = BITS; i >= 0; i--) {",
			"\t\t\tif(node->next[0]) {",
			"\t\t\t\tnode = node->next[0];",
			"\t\t\t} else if(node->next[1]) {",
			"\t\t\t\tans |= (1LL << i);",
			"\t\t\t\tnode = node->next[1];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"",
			"\t// Query maximum XOR with num",
			"\tlong long maxXor(long long num) {",
			"\t\tBitTrieNode* node = root;",
			"\t\tlong long ans = 0;",
			"\t\tfor(int i = BITS; i >= 0; i--) {",
			"\t\t\tint b = (num >> i) & 1;",
			"\t\t\tif(node->next[1 - b]) {",
			"\t\t\t\tans |= (1LL << i);",
			"\t\t\t\tnode = node->next[1 - b];",
			"\t\t\t} else {",
			"\t\t\t\tnode = node->next[b];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"",
			"\t// Query minimum XOR with num",
			"\tlong long minXor(long long num) {",
			"\t\tBitTrieNode* node = root;",
			"\t\tlong long ans = 0;",
			"\t\tfor(int i = BITS; i >= 0; i--) {",
			"\t\t\tint b = (num >> i) & 1;",
			"\t\t\tif(node->next[b]) {",
			"\t\t\t\tnode = node->next[b];",
			"\t\t\t} else {",
			"\t\t\t\tans |= (1LL << i);",
			"\t\t\t\tnode = node->next[1 - b];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
