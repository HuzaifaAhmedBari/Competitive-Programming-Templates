			"ll modpow(ll a, ll b, ll m = MoD) {",
			"\tll res = 1;",
			"\twhile (b) {",
			"\t\tif (b & 1)",
			"\t\t\tres = (res * a) % m;",
			"\t\ta = (a * a) % m;",
			"\t\tb >>= 1;",
			"\t}",
			"\treturn res;",
			"}",
			"",
			"void build_fact(ll n) {",
			"\tfact.assign(n+1, 1);",
			"\tinvfact.assign(n+1, 1);",
			"",
			"\tfor (ll i = 1; i <= n; i++)",
			"\t\tfact[i] = (fact[i-1] * i) % MoD;",
			"",
			"\tinvfact[n] = modpow(fact[n], MoD-2, MoD); // Fermat's inverse",
			"",
			"\tfor (ll i = n-1; i >= 0; i--)",
			"\t\tinvfact[i] = (invfact[i+1] * (i+1)) % MoD;",
			"}",
			"",
			"ll nCr(ll n, ll r) {",
