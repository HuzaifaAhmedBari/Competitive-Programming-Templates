{
    "KMP String Matching": {
		"prefix": ["kmp", "KMP"],
		"body": [
			"vl build_lps(const string &pat) {",
			"\tll m = pat.size();",
			"\tvl lps(m, 0);",
			"",
			"\tfor (ll i = 1, len = 0; i < m; ) {",
			"\t\tif (pat[i] == pat[len]) {",
			"\t\t\tlps[i++] = ++len;",
			"\t\t} else {",
			"\t\t\tif (len != 0) {",
			"\t\t\t\tlen = lps[len - 1];",
			"\t\t\t} else {",
			"\t\t\t\tlps[i++] = 0;",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"\treturn lps;",
			"}",
			"",
			"vl kmp(const string &text, const string &pat) {",
			"\tll n = text.size(), m = pat.size();",
			"\tvl lps = build_lps(pat);",
			"\tvl occurrences;",
			"",
			"\tfor (ll i = 0, j = 0; i < n; ) {",
			"\t\tif (text[i] == pat[j]) {",
			"\t\t\ti++; j++;",
			"\t\t}",
			"",
			"\t\tif (j == m) {",
			"\t\t\toccurrences.push_back(i - j);",
			"\t\t\tj = lps[j - 1];",
			"\t\t} else if (i < n && text[i] != pat[j]) {",
			"\t\t\tif (j != 0)",
			"\t\t\t\tj = lps[j - 1];",
			"\t\t\telse",
			"\t\t\t\ti++;",
			"\t\t}",
			"\t}",
			"\treturn occurrences;",
			"}"
		],
		"description": "Knuth-Morris-Pratt (KMP) algorithm for pattern matching in O(n + m). Builds LPS array and returns all 0-based occurrences of pattern in text."
	}
}