{
    "Polynomial Hash (Double Hash)": {
        "prefix": ["Hashing" , "hashing" , "polyhash"],
        "body": [
        "using ull = unsigned long long;",
        "",
        "ll gen_base(ll l = 257) {",
        "\tauto t = chrono::steady_clock::now().time_since_epoch().count();",
        "\tmt19937_64 r(t);",
        "\treturn (l + r() % (ll)(1e9 - l)) | 1;",
        "}",
        "",
        "struct PolyHash {",
        "\tstatic const ll M = 1000000007;",
        "\tll n;",
        "\tvector<ll> h, p;",
        "\tvector<ull> H, P;",
        "",
        "\tPolyHash(string s, ll b = 0) : n(s.size()) {",
        "\t\tif (!b) b = gen_base();",
        "\t\th.resize(n + 1);",
        "\t\tp.assign(n + 1, 1);",
        "\t\tH.resize(n + 1);",
        "\t\tP.assign(n + 1, 1);",
        "\t\tfor (ll i = 0; i < n; ++i) {",
        "\t\t\th[i + 1] = (1LL * h[i] * b + (unsigned char)s[i]) % M;",
        "\t\t\tp[i + 1] = 1LL * p[i] * b % M;",
        "\t\t\tH[i + 1] = H[i] * b + (unsigned char)s[i];",
        "\t\t\tP[i + 1] = P[i] * b;",
        "\t\t}",
        "\t}",
        "",
        "\t// get hash of substring [l, l+len)",
        "\tpair<ll, ull> get(ll l, ll len) {",
        "\t\tll r = l + len;",
        "\t\tll v = (h[r] - 1LL * h[l] * p[len] % M + M) % M;",
        "\t\treturn {v, H[r] - H[l] * P[len]};",
        "\t}",
        "",
        "\t// get hash of string excluding range [L, R]",
        "\tpair<ll, ull> exclude(ll L, ll R) {",
        "\t\tif (!n) return {0, 0};",
        "\t\tL = max(0LL, L);",
        "\t\tR = min(n - 1, R);",
        "\t\tif (L > R) return get(0, n);",
        "\t\tauto x = get(0, L);",
        "\t\tauto y = get(R + 1, n - 1 - R);",
        "\t\tll v = (1LL * x.first * p[n - 1 - R] + y.first) % M;",
        "\t\treturn {v, x.second * P[n - 1 - R] + y.second};",
        "\t}",
        "};"
        ]
    }
}