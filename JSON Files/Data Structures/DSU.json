{
    "DSU Class": {
		"prefix": ["Disjoint" , "disjoint"],
		"body": [
			"class DSU {",
			"private:",
			"\tll n, components;",
			"\tvl parent, size;",
			"",
			"public:",
			"\tDSU(int n) : n(n), components(n) {",
			"\t\tparent.resize(n+1);",
			"\t\tsize.resize(n+1, 1);",
			"\t\tiota(all(parent), 1);",
			"\t}",
			"",
			"\tll find(ll x) {",
			"\t\tif (parent[x] != x)",
			"\t\t\tparent[x] = find(parent[x]);",
			"\t\treturn parent[x];",
			"\t}",
			"",
			"\tbool unite(ll a, ll b) {",
			"\t\ta = find(a);",
			"\t\tb = find(b);",
			"\t\tif (a == b)",
			"\t\t\treturn false;",
			"",
			"\t\tif (size[a] < size[b])",
			"\t\t\tswap(a, b);",
			"\t\tparent[b] = a;",
			"\t\tsize[a] += size[b];",
			"\t\tcomponents--;",
			"\t\treturn true;",
			"\t}",
			"",
			"\tbool connected(ll a, ll b) {",
			"\t\treturn find(a) == find(b);",
			"\t}",
			"",
			"\tll getSize(ll x) {",
			"\t\treturn size[find(x)];",
			"\t}",
			"};"
		]
	}
}
