{
	"Bit Trie with Insert Delete and XOR Queries": {
		"prefix": ["BitTrie", "bittrie"],
		"body": [
		"struct BitTrieNode {",
		"\tBitTrieNode* next[2];",
		"\tint cnt;",
		"\tBitTrieNode() {",
		"\t\tnext[0] = next[1] = nullptr;",
		"\t\tcnt = 0;",
		"\t}",
		"};",
		"",
		"struct BitTrie {",
		"\tBitTrieNode* root;",
		"\tstatic const int BITS = 31; // for int (use 63 for long long)",
		"",
		"\tBitTrie() {",
		"\t\troot = new BitTrieNode();",
		"\t}",
		"",
		"\t// Insert number",
		"\tvoid insert(long long num) {",
		"\t\tBitTrieNode* node = root;",
		"\t\tnode->cnt++;",
		"\t\tfor(int i = BITS; i >= 0; i--) {",
		"\t\t\tint b = (num >> i) & 1;",
		"\t\t\tif(!node->next[b])",
		"\t\t\t\tnode->next[b] = new BitTrieNode();",
		"\t\t\tnode = node->next[b];",
		"\t\t\tnode->cnt++;",
		"\t\t}",
		"\t}",
		"",
		"\t// Remove number",
		"\tvoid remove(long long num) {",
		"\t\tBitTrieNode* node = root;",
		"\t\tnode->cnt--;",
		"",
		"\t\tfor(int i = BITS; i >= 0; i--) {",
		"\t\t\tint b = (num >> i) & 1;",
		"\t\t\tBitTrieNode* nxt = node->next[b];",
		"",
		"\t\t\tnxt->cnt--;",
		"\t\t\tif(nxt->cnt == 0) {",
		"\t\t\t\tdelete nxt;",
		"\t\t\t\tnode->next[b] = nullptr;",
		"\t\t\t\treturn;",
		"\t\t\t}",
		"\t\t\tnode = nxt;",
		"\t\t}",
		"\t}",
		"",
		"\t// Maximum XOR",
		"\tlong long maxXor(long long num) {",
		"\t\tBitTrieNode* node = root;",
		"\t\tlong long ans = 0;",
		"\t\tfor(int i = BITS; i >= 0; i--) {",
		"\t\t\tint b = (num >> i) & 1;",
		"\t\t\tif(node->next[1 - b] && node->next[1 - b]->cnt > 0) {",
		"\t\t\t\tans |= (1LL << i);",
		"\t\t\t\tnode = node->next[1 - b];",
		"\t\t\t} else {",
		"\t\t\t\tnode = node->next[b];",
		"\t\t\t}",
		"\t\t}",
		"\t\treturn ans;",
		"\t}",
		"",
		"\t// Minimum XOR",
		"\tlong long minXor(long long num) {",
		"\t\tBitTrieNode* node = root;",
		"\t\tlong long ans = 0;",
		"\t\tfor(int i = BITS; i >= 0; i--) {",
		"\t\t\tint b = (num >> i) & 1;",
		"\t\t\tif(node->next[b] && node->next[b]->cnt > 0) {",
		"\t\t\t\tnode = node->next[b];",
		"\t\t\t} else {",
		"\t\t\t\tans |= (1LL << i);",
		"\t\t\t\tnode = node->next[1 - b];",
		"\t\t\t}",
		"\t\t}",
		"\t\treturn ans;",
		"\t}",
		"",
		"\t// Check if trie is empty",
		"\tbool empty() {",
		"\t\treturn root->cnt == 0;",
		"\t}",
		"};"
		]
	}
}