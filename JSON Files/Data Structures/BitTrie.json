			"\t\t\t\t} else break;",
			"\t\t\t} else {",
			"\t\t\t\tif(node->next[0]) node = node->next[0];",
			"\t\t\t\telse if(node->next[1]) node = node->next[1];",
			"\t\t\t\telse break;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"};"
		]
