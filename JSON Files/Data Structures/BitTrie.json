			"\t\t\t\tans |= (1LL << i);",
			"\t\t\t\tnode = node->next[1];",
			"\t\t\t} else if(node->next[(num >> i) & 1]) {",
			"\t\t\t\tnode = node->next[(num >> i) & 1];",
			"\t\t\t} else if(node->next[0]) {",
			"\t\t\t\tnode = node->next[0];",
			"\t\t\t} else {",
			"\t\t\t\tbreak;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"",
			"\t// Query minimum AND with num",
