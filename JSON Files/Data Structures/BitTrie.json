			"\t\t\tint b = (num >> i) & 1;",
			"\t\t\tif(node->next[1 - b]) {",
			"\t\t\t\tans |= (1LL << i);",
			"\t\t\t\tnode = node->next[1 - b];",
			"\t\t\t} else {",
			"\t\t\t\tnode = node->next[b];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"",
			"\t// Query minimum XOR with num",
			"\tlong long minXor(long long num) {",
			"\t\tBitTrieNode* node = root;",
			"\t\tlong long ans = 0;",
			"\t\tfor(int i = BITS; i >= 0; i--) {",
			"\t\t\tint b = (num >> i) & 1;",
			"\t\t\tif(node->next[b]) {",
			"\t\t\t\tnode = node->next[b];",
			"\t\t\t} else {",
			"\t\t\t\tans |= (1LL << i);",
			"\t\t\t\tnode = node->next[1 - b];",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"",
			"\t// Query maximum OR with num",
			"\tlong long maxOr(long long num) {",
			"\t\tBitTrieNode* node = root;",
			"\t\tlong long ans = num;",
			"\t\tfor(int i = BITS; i >= 0; i--) {",
			"\t\t\tif(((num >> i) & 1) == 0 && node->next[1]) {",
			"\t\t\t\tans |= (1LL << i);",
			"\t\t\t\tnode = node->next[1];",
			"\t\t\t} else if(node->next[(num >> i) & 1]) {",
			"\t\t\t\tnode = node->next[(num >> i) & 1];",
			"\t\t\t} else {",
			"\t\t\t\tbreak;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"",
			"\t// Query minimum OR with num",
			"\tlong long minOr(long long num) {",
			"\t\tBitTrieNode* node = root;",
			"\t\tlong long ans = num;",
			"\t\tfor(int i = BITS; i >= 0; i--) {",
			"\t\t\tint b = (num >> i) & 1;",
			"\t\t\tif(b == 1) {",
			"\t\t\t\tif(node->next[1]) node = node->next[1];",
			"\t\t\t\telse if(node->next[0]) node = node->next[0];",
			"\t\t\t\telse break;",
			"\t\t\t} else {",
			"\t\t\t\tif(node->next[0]) {",
			"\t\t\t\t\tnode = node->next[0];",
			"\t\t\t\t} else if(node->next[1]) {",
			"\t\t\t\t\tans |= (1LL << i);",
			"\t\t\t\t\tnode = node->next[1];",
			"\t\t\t\t} else break;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ans;",
			"\t}",
			"",
			"\t// Query maximum AND with num",
