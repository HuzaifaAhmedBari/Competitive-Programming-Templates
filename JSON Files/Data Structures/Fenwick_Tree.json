{
	"Fenwick Tree": {
		"prefix": ["Fenwick" , "fenwick"],
		"body": [
			"struct Fenwick {",
			"\tint n;",
			"\tvector<long long> bit;",
			"",
			"\tFenwick(int n = 0) {",
			"\t\tinit(n);",
			"\t}",
			"",
			"\t\tvoid init(int n_) {",
			"\t\tn = n_;",
			"\t\tbit.assign(n + 1, 0);",
			"\t}",
			"",
			"\t// add delta at index i (0-based)",
			"\tvoid update(int i, long long delta) {",
			"\t\tfor (++i; i <= n; i += i & -i)",
			"\t\t\tbit[i] += delta;",
			"\t}",
			"",
			"\t// prefix sum [0..i]",
			"\tlong long query(int i) {",
			"\t\tlong long s = 0;",
			"\t\tfor (++i; i > 0; i -= i & -i)",
			"\t\t\ts += bit[i];",
			"\t\treturn s;",
			"\t}",
			"",
			"\t// sum in [l..r]",
			"\tlong long rangeQuery(int l, int r) {",
			"\t\tif (l > r) return 0;",
			"\t\treturn query(r) - (l ? query(l - 1) : 0);",
			"\t}",
			"",
			"\t// find smallest index with prefix sum >= k",
			"\t// assumes all frequencies are non-negative",
			"\tint kth(long long k) {",
			"\t\tint pos = 0;",
			"\t\tlong long sum = 0;",
			"\t\tint logn = 31 - __builtin_clz(n);",
			"\t\tfor (int i = 1 << logn; i > 0; i >>= 1) {",
			"\t\t\tif (pos + i <= n && sum + bit[pos + i] < k) {",
			"\t\t\t\tsum += bit[pos + i];",
			"\t\t\t\tpos += i;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn pos; // 0-based index",
			"\t}",
			"};"
		]
    }
}