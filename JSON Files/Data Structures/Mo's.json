{
	"Hilbert Order Mo's Algorithm": {
		"prefix": ["Mos" , "mos" , "hilbertmos"],
		"body": [
			"ll hilbertOrder(ll x, ll y, ll pow = 21, ll rot = 0) {",
			"\tif (pow == 0) return 0;",
			"",
			"\tll hpow = 1 << (pow - 1);",
			"\tll seg = (x < hpow) ? ((y < hpow) ? 0 : 3)",
			"\t\t\t\t\t : ((y < hpow) ? 1 : 2);",
			"",
			"\tseg = (seg + rot) & 3;",
			"\tconst ll rotateDelta[4] = {3, 0, 0, 1};",
			"\tll nx = x & (x ^ hpow), ny = y & (y ^ hpow);",
			"\tll nrot = (rot + rotateDelta[seg]) & 3;",
			"",
			"\tll subSquareSize = 1LL << (2 * pow - 2);",
			"\tll ord = seg * subSquareSize;",
			"",
			"\tll add = hilbertOrder(nx, ny, pow - 1, nrot);",
			"\tord += (seg == 1 || seg == 2) ? add : (subSquareSize - add - 1);",
			"",
			"\treturn ord;",
			"}",
			"",
			"struct Query {",
			"\tll l, r, id;",
			"\tll ord;",
			"",
			"\tvoid calcOrder() {",
			"\t\tord = hilbertOrder(l, r);",
			"\t}",
			"};",
			"",
			"bool cmp(const Query &a, const Query &b) {",
			"\treturn a.ord < b.ord;",
			"}",
			"",
			"const ll MAXN = 200005;",
			"ll A[MAXN];",
			"ll ans[MAXN];",
			"",
			"ll freq[1000005];",
			"ll current_answer = 0;",
			"",
			"// ------------ ADD / REMOVE FUNCTIONS ------------",
			"",
			"void add(ll idx) {",
			"\tll x = A[idx];",
			"\t// Example: number of distinct elements",
			"\tif (freq[x] == 0) current_answer++;",
			"\tfreq[x]++;",
			"}",
			"",
			"void remove_(ll idx) {",
			"\tll x = A[idx];",
			"\tfreq[x]--;",
			"\tif (freq[x] == 0) current_answer--;",
			"}",
