{
    "String Trie": {
		"prefix": ["StringTrie" , "stringtrie"],
		"body": [
			"struct TrieNode {",
			"\tTrieNode* next[26];",
			"\tbool isEnd;",
			"\tint count;",
			"",
			"\tTrieNode() {",
			"\t\tfor (int i = 0; i < 26; i++) next[i] = nullptr;",
			"\t\tisEnd = false;",
			"\t\tcount = 0;",
			"\t}",
			"};",
			"",
			"struct Trie {",
			"\tTrieNode* root;",
			"",
			"\tTrie() {",
			"\t\troot = new TrieNode();",
			"\t}",
			"",
			"\t// Insert word",
			"\tvoid insert(const string &word) {",
			"\t\tTrieNode* node = root;",
			"\t\tfor (char c : word) {",
			"\t\t\tint idx = c - 'a';",
			"\t\t\tif (!node->next[idx]) node->next[idx] = new TrieNode();",
			"\t\t\tnode = node->next[idx];",
			"\t\t\tnode->count++;",
			"\t\t}",
			"\t\tnode->isEnd = true;",
			"\t}",
			"",
			"\t// Search full word",
			"\tbool search(const string &word) {",
			"\t\tTrieNode* node = root;",
			"\t\tfor (char c : word) {",
			"\t\t\tint idx = c - 'a';",
			"\t\t\tif (!node->next[idx]) return false;",
			"\t\t\tnode = node->next[idx];",
			"\t\t}",
			"\t\treturn node->isEnd;",
			"\t}",
			"",
			"\t// Check if prefix exists",
			"\tbool startsWith(const string &prefix) {",
			"\t\tTrieNode* node = root;",
			"\t\tfor (char c : prefix) {",
			"\t\t\tint idx = c - 'a';",
			"\t\t\tif (!node->next[idx]) return false;",
			"\t\t\tnode = node->next[idx];",
			"\t\t}",
			"\t\treturn true;",
			"\t}",
			"",
			"\t// Count words with given prefix",
			"\tint countPrefix(const string &prefix) {",
			"\t\tTrieNode* node = root;",
			"\t\tfor (char c : prefix) {",
			"\t\t\tint idx = c - 'a';",
			"\t\t\tif (!node->next[idx]) return 0;",
			"\t\t\tnode = node->next[idx];",
			"\t\t}",
			"\t\treturn node->count;",
			"\t}",
			"};"
		]
	}
}